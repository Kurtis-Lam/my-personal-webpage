{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/home", "destination": "/index.html" },
      { "source": "/colordle-solver", "destination": "/colordle.html" },
      { "source": "/gggrinder", "destination": "/grinder.html" },
      { "source": "/hbd-twin", "destination": "/birthday.html" },
      { "source": "/kahoot-hack", "destination": "/kahoot-hack.html" },
      { "source": "/monkeytyper", "destination": "/monkeytyper.html" }
    ]
  }
}